apiVersion: v1
kind: Namespace
metadata:
  name: "{{ env }}"
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: notes-api
  namespace: "{{ env }}"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: notes-api
  template:
    metadata:
      labels:
        app: notes-api
    spec:
      containers:
      - name: notes-api
        image: "{{ docker_user }}/notes-api:{{ image_tag | default('latest') }}"
        imagePullPolicy: Always
        ports:
        - containerPort: 5000
        env:
        - name: AUTH_SERVICE_URL
          value: "http://auth-service.{{ env }}.svc.cluster.local:5001"
        - name: AUDIT_SERVICE_URL
          value: "http://audit-service.{{ env }}.svc.cluster.local:5002"
        resources:
          requests:
            cpu: "100m"
          limits:
            cpu: "500m"
---
apiVersion: v1
kind: Service
metadata:
  name: notes-api
  namespace: "{{ env }}"
spec:
  type: NodePort
  selector:
    app: notes-api
  ports:
  - port: 5000
    targetPort: 5000
    nodePort: {{ 30010 if env == 'staging' else 30020 }}
---
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: notes-api-hpa
  namespace: "{{ env }}"
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: notes-api
  minReplicas: 1
  maxReplicas: 3
  metrics:
  - type: Resource
    resource:
      name: cpu
      target:
        type: Utilization
        averageUtilization: 70
