pipeline {
    agent any

    environment {
        DOCKERHUB_CREDENTIALS = credentials('dockerhub-creds')
        SONAR_TOKEN = credentials('sonar-token')
        GITHUB_URL = 'https://github.com/yourusername/secure-notes.git'
        IMAGE_TAG = "${env.BUILD_ID}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Gitleaks') {
            steps {
                sh 'docker run -v ${WORKSPACE}:/path zricethezav/gitleaks:latest detect --source="/path" -v'
            }
        }

        stage('SonarQube Analysis') {
            environment {
                scannerHome = tool 'SonarQubeScanner'
            }
            steps {
                withSonarQubeEnv('SonarQube') {
                    sh "${scannerHome}/bin/sonar-scanner -Dproject.settings=services/auth-service/sonar-project.properties"
                    sh "${scannerHome}/bin/sonar-scanner -Dproject.settings=services/notes-api/sonar-project.properties"
                    sh "${scannerHome}/bin/sonar-scanner -Dproject.settings=services/audit-service/sonar-project.properties"
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 1, unit: 'HOURS') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Trivy Vulnerability Scan') {
            steps {
                sh 'trivy fs --severity HIGH,CRITICAL services/auth-service/requirements.txt'
                sh 'trivy fs --severity HIGH,CRITICAL services/notes-api/requirements.txt'
                sh 'trivy fs --severity HIGH,CRITICAL services/audit-service/requirements.txt'
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build -t ${DOCKERHUB_CREDENTIALS_USR}/auth-service:${IMAGE_TAG} services/auth-service'
                sh 'docker build -t ${DOCKERHUB_CREDENTIALS_USR}/notes-api:${IMAGE_TAG} services/notes-api'
                sh 'docker build -t ${DOCKERHUB_CREDENTIALS_USR}/audit-service:${IMAGE_TAG} services/audit-service'
            }
        }

        stage('Docker Push') {
            steps {
                sh 'echo $DOCKERHUB_CREDENTIALS_PSW | docker login -u $DOCKERHUB_CREDENTIALS_USR --password-stdin'
                sh 'docker push ${DOCKERHUB_CREDENTIALS_USR}/auth-service:${IMAGE_TAG}'
                sh 'docker push ${DOCKERHUB_CREDENTIALS_USR}/notes-api:${IMAGE_TAG}'
                sh 'docker push ${DOCKERHUB_CREDENTIALS_USR}/audit-service:${IMAGE_TAG}'
            }
        }

        stage('Deploy Staging') {
            steps {
                sh 'ansible-playbook -i ansible/inventory.ini ansible/site.yml -e env=staging -e image_tag=${IMAGE_TAG} -e docker_user=${DOCKERHUB_CREDENTIALS_USR}'
            }
        }

        stage('ZAP Scan') {
            steps {
                sh 'docker run --network devsecops-net -v $(pwd):/zap/wrk/:rw -t ghcr.io/zaproxy/zaproxy:stable zap-baseline.py -t http://notes-api-staging:5000 -I'
            }
        }

        stage('Deploy Production') {
            steps {
                sh 'ansible-playbook -i ansible/inventory.ini ansible/site.yml -e env=production -e image_tag=${IMAGE_TAG} -e docker_user=${DOCKERHUB_CREDENTIALS_USR}'
            }
        }
    }

    post {
        always {
            echo "Pipeline execution finished."
        }
        success {
            echo "Pipeline succeeded! Sending email notification..."
            mail to: '18BCS1429@gmail.com, md.maroofnzhs@gmail.com',
                 subject: "SUCCESS: DevSecOps Pipeline '${JOB_NAME}' [${BUILD_NUMBER}]",
                 body: "Great news! The Secure Notes pipeline executed successfully. All security scans passed and the application is deployed to production.\n\nView the detailed Jenkins logs here: ${BUILD_URL}"
        }
        failure {
            echo "Pipeline failed! Sending alert email..."
            mail to: '18BCS1429@gmail.com, md.maroofnzhs@gmail.com',
                 subject: "FAILURE: DevSecOps Pipeline '${JOB_NAME}' [${BUILD_NUMBER}]",
                 body: "ALERT: The Secure Notes pipeline has FAILED. This could be due to a failed security scan or a deployment error.\n\nPlease check the Jenkins logs immediately to investigate the issue: ${BUILD_URL}"
        }
    }
}
